---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../site';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  published?: string;
  robots?: string;
  jsonLd?: unknown;
  imagePath?: string;
  imageAlt?: string;
  canonicalPath?: string;
  lang?: 'en' | 'ru';
  alternates?: { lang: string; href: string }[];
}

const {
  title,
  description,
  ogType = 'website',
  published,
  robots = 'index,follow',
  jsonLd,
  imagePath = '/og.png',
  imageAlt = `${site.name}, AI systems builder and writer`,
  canonicalPath,
  lang = 'en',
  alternates = [],
} = Astro.props;

const isHome = Astro.url.pathname === '/';
const documentTitle = isHome ? title : `${title} | ${site.name}`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site.url);
const image = new URL(imagePath, site.url).href;
const ogLocale = lang === 'ru' ? 'ru_RU' : site.locale;
const jsonLdMarkup = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var theme = 'light';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
          else if (window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
        } catch (error) {
          theme = 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <script is:inline>
      (function () {
        // Send first-time readers to the site in their browser's language, and
        // keep readers on the language they last chose. Nothing leaves the browser.
        var langs = ['zh', 'es', 'fr', 'ru', 'tr', 'de', 'it', 'pt'];
        var path = location.pathname;
        if (path.indexOf('/projects/') === 0) return;
        var match = path.match(/^\/([a-z]{2})(\/|$)/);
        var current = match && langs.indexOf(match[1]) >= 0 ? match[1] : 'en';
        var chosen = null;
        try {
          chosen = localStorage.getItem('lang');
        } catch (error) {
          chosen = null;
        }
        var target = chosen;
        if (!target) {
          var prefs = navigator.languages || [navigator.language || ''];
          for (var i = 0; i < prefs.length && !target; i++) {
            var code = String(prefs[i]).slice(0, 2).toLowerCase();
            if (code === 'en') target = 'en';
            else if (langs.indexOf(code) >= 0) target = code;
          }
          if (!target) return;
          try {
            localStorage.setItem('lang', target);
          } catch (error) {
            /* Remembering is a convenience; the redirect still works without it. */
          }
        }
        if (target === current) return;
        var rest = current === 'en' ? path : path.slice(current.length + 1) || '/';
        var next = (target === 'en' ? '' : '/' + target) + rest;
        if (next !== path) location.replace(next + location.search + location.hash);
      })();
    </script>
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical.href} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={new URL(alt.href, site.url).href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f3efe7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={ogLocale} />
    {published && <meta property="article:published_time" content={`${published}T12:00:00.000Z`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href={new URL('/rss.xml', site.url)}
    />
    {jsonLdMarkup && <script type="application/ld+json" set:html={jsonLdMarkup} />}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header />
    <main id="content" tabindex="-1">
      <div class="shell page">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
