---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../site';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  published?: string;
  robots?: string;
  jsonLd?: unknown;
}

const {
  title,
  description,
  ogType = 'website',
  published,
  robots = 'index,follow',
  jsonLd,
} = Astro.props;

const isHome = Astro.url.pathname === '/';
const documentTitle = isHome ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url);
const image = new URL('/og.png', site.url).href;
const jsonLdMarkup = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var theme = 'light';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
          else if (window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
        } catch (error) {
          theme = 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f3efe7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={`${site.name}, technologist, investor, builder`} />
    <meta property="og:locale" content={site.locale} />
    {published && <meta property="article:published_time" content={`${published}T12:00:00.000Z`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href={new URL('/rss.xml', site.url)}
    />
    {jsonLdMarkup && <script type="application/ld+json" set:html={jsonLdMarkup} />}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header />
    <main id="content" tabindex="-1">
      <div class="shell page">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
