---
import { render } from 'astro:content';
import Longform from '../../components/Longform.astro';
import { publishedProjects } from '../../lib/content';
import { workJsonLd } from '../../lib/jsonld';
import { workKindLabel } from '../../lib/projects';
import { ideasRelatedTo } from '../../lib/related';
import Related from '../../components/Related.astro';
import { site } from '../../site';

export async function getStaticPaths() {
  const projects = await publishedProjects();
  return projects.map((entry) => ({ params: { id: entry.id } }));
}

const id = Astro.params.id;
if (!id) throw new Error('Missing work id');

const projects = await publishedProjects();
const entry = projects.find((item) => item.id === id);
if (!entry) throw new Error(`Missing work: ${id}`);

const { Content } = await render(entry);
const url = new URL(`/work/${entry.id}/`, site.url).href;
const ideas = await ideasRelatedTo(`/work/${entry.id}/`);
---

<Longform
  kicker="Work"
  kickerHref="/work/"
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  jsonLd={workJsonLd({
    title: entry.data.title,
    description: entry.data.description,
    date: entry.data.date,
    url,
  })}
>
  <p class="resource-links" slot="meta">
    <span>{workKindLabel(entry.data.kind)}</span>
    <span>{entry.data.role}</span>
    {
      entry.data.links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))
    }
  </p>
  <Content />
  <Related slot="end" heading="Ideas this work tested" items={ideas} />
</Longform>
