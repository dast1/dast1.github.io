---
// Legacy route. Each entry now lives under /work/.
import { publishedProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await publishedProjects();
  return projects.map((entry) => ({ params: { id: entry.id } }));
}

return Astro.redirect(`/work/${Astro.params.id}/`, 301);
---
