---
import Base from '../../layouts/Base.astro';
import { publishedProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await publishedProjects();
  return projects.map((entry) => ({ params: { id: entry.id } }));
}

const id = Astro.params.id;
if (!id) {
  throw new Error('Missing project id');
}

const projects = await publishedProjects();
const entry = projects.find((item) => item.id === id);
if (!entry) {
  throw new Error(`Missing project: ${id}`);
}

---

<Base
  title={entry.data.title}
  description={entry.data.description}
  robots="noindex,follow"
  canonicalPath={`/work/${entry.id}/`}
>
  <section class="legacy-tag">
    <h1>{entry.data.title}</h1>
    <p>
      This entry moved to <a href={`/work/${entry.id}/`}>the Work archive</a>.
    </p>
  </section>
</Base>
