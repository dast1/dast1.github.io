---
import Base from '../../layouts/Base.astro';
import { publishedWriting, tagPath, writingTags } from '../../lib/content';
import { formatDate } from '../../lib/dates';
import { readingMinutes } from '../../lib/reading-time';

const posts = await publishedWriting();
const tags = await writingTags();
const lead = posts.find((entry) => entry.data.featuredEssay) ?? posts[0];
const archive = posts.filter((entry) => entry.id !== lead?.id);
const researchThreads = [
  {
    id: 'delegated-authority',
    title: 'Delegated authority',
    question: 'What changes when an AI system moves from producing information to taking action?',
    entryId: 'context-is-the-product',
  },
  {
    id: 'personal-ai',
    title: 'Personal AI',
    question: 'What should remain near the person when AI becomes part of ordinary computing?',
    entryId: 'the-computer-should-be-personal',
  },
  {
    id: 'distributed-governance',
    title: 'Distributed governance',
    question: 'Where does policy attach when computation crosses independently owned machines?',
    entryId: 'capacity-is-not-consent',
  },
  {
    id: 'ownership-incentives',
    title: 'Ownership and incentives',
    question: 'Who decides, who carries the risk, and who remains responsible?',
    entryId: 'what-owners-notice',
  },
].map((thread) => ({ ...thread, entry: posts.find((entry) => entry.id === thread.entryId) }));
const description =
  'Long-form writing by Dastan Aitzhanov on governed AI systems, personal computing, ownership, and the economics around them.';
---

<Base title="Writing" description={description}>
  <header class="writing-masthead">
    <h1>Writing</h1>
    <p>
      Longer arguments about capable systems, the people who remain responsible for them, and the
      economics underneath both.
    </p>
  </header>

  {
    lead && (
      <article class="writing-lead">
        <div class="writing-lead-copy">
          <h2><a href={`/writing/${lead.id}/`}>{lead.data.title}</a></h2>
          <p>{lead.data.description}</p>
        </div>
        <div class="writing-lead-meta">
          <p>
            <time datetime={lead.data.date}>{formatDate(lead.data.date)}</time>
            <span aria-hidden="true"> · </span>
            <span>{readingMinutes(lead.body)} min read</span>
          </p>
          <p>
            <span>Current inquiry</span>
            <strong>Distributed governance</strong>
          </p>
          <ul aria-label="Topics">
            {lead.data.tags.map((label) => (
              <li><a href={tagPath(label)}>{label}</a></li>
            ))}
          </ul>
        </div>
      </article>
    )
  }

  {
    researchThreads.length > 0 && (
      <section class="writing-threads" aria-labelledby="threads-title">
        <header>
          <h2 id="threads-title">Research threads</h2>
          <p>Four questions connect the longer arguments. Each is incomplete by design.</p>
        </header>
        <ol>
          {researchThreads.map((thread, index) => (
            <li id={thread.id}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{thread.title}</h3>
                <p>{thread.question}</p>
                {thread.entry && (
                  <a class="writing-thread-link" href={`/writing/${thread.entry.id}/`}>
                    Begin with “{thread.entry.data.title}”
                  </a>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="writing-archive" aria-labelledby="archive-title">
    <header>
      <div>
        <h2 id="archive-title">More essays</h2>
        <p>Arguments that needed more room than an idea.</p>
      </div>
      <nav class="writing-topics" aria-label="Writing topics">
        <span>Browse topics</span>
        <ul>
          {
            tags.map((tag) => (
              <li>
                <a href={tagPath(tag.label)}>
                  {tag.label} <span>{tag.count}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <ol class="writing-list">
      {
        archive.map((entry) => (
          <li>
            <div class="writing-list-meta">
              <time datetime={entry.data.date}>{formatDate(entry.data.date)}</time>
              <span>{readingMinutes(entry.body)} min</span>
            </div>
            <div>
              <h3><a href={`/writing/${entry.id}/`}>{entry.data.title}</a></h3>
              <p>{entry.data.description}</p>
              <ul aria-label="Topics">
                {entry.data.tags.map((label) => (
                  <li><a href={tagPath(label)}>{label}</a></li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Base>
