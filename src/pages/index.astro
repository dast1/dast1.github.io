---
import EntryList from '../components/EntryList.astro';
import Base from '../layouts/Base.astro';
import { publishedIdeas, publishedWriting, tagPath } from '../lib/content';
import { formatDate } from '../lib/dates';
import { siteJsonLd } from '../lib/jsonld';
import { site } from '../site';

const writing = (await publishedWriting()).slice(0, 3);
const ideas = (await publishedIdeas()).slice(0, 3);

const currentQuestions = [
  'What should stay local as AI becomes a persistent part of personal computing?',
  'How should agents hand work off to deterministic systems and people?',
  'Where does better context matter more than a larger model?',
  'What changes when AI becomes part of an organization\'s operating model, not just another tool?',
];
---

<Base title={site.title} description={site.description} jsonLd={siteJsonLd()}>
  <h1 class="home-title">{site.name}</h1>
  <p class="deck">Technologist · Investor · Builder</p>

  <div class="prose home-prose">
    <p>
      I have spent most of my career around systems that move information and capital: cloud
      infrastructure, data platforms, machine learning, and investing. I worked at Amazon Web
      Services and Databricks, and for roughly a decade I have also invested personal and family
      capital across real estate, public markets, technology, and private investments.
    </p>
    <p>
      These days I am especially interested in what happens as AI moves from a tool we call on
      occasionally to a persistent layer of computing: agents, local inference, context, routing,
      and the operating models that emerge when software can do more than answer questions.
    </p>
    <p>
      This site is where I keep the parts worth returning to. Longer pieces live under
      <a href="/writing/">writing</a>, shorter claims under <a href="/ideas/">ideas</a>, and
      <a href="/projects/">projects</a> is reserved for work I can actually point to.
    </p>
  </div>

  <h2 class="section-label" id="questions">Current questions</h2>
  <ul class="current-questions" aria-labelledby="questions">
    {currentQuestions.map((question) => <li>{question}</li>)}
  </ul>

  <h2 class="section-label" id="writing">Writing</h2>
  <EntryList
    items={writing.map((entry) => ({
      href: `/writing/${entry.id}/`,
      title: entry.data.title,
      datetime: entry.data.date,
      dateLabel: formatDate(entry.data.date),
      summary: entry.data.description,
      tags: entry.data.tags.map((label) => ({ label, href: tagPath(label) })),
    }))}
  />
  <p class="more"><a href="/writing/">All writing</a></p>

  <h2 class="section-label" id="ideas">Ideas</h2>
  <EntryList
    items={ideas.map((entry) => ({
      href: `/ideas/${entry.id}/`,
      title: entry.data.title,
      datetime: entry.data.date,
      dateLabel: formatDate(entry.data.date),
      summary: entry.data.description,
    }))}
  />
  <p class="more"><a href="/ideas/">All ideas</a></p>
</Base>
