---
import EntryList from '../components/EntryList.astro';
import Base from '../layouts/Base.astro';
import { publishedIdeas, publishedProjects, publishedWriting, tagPath } from '../lib/content';
import { formatDate, formatMonth } from '../lib/dates';
import { ideaTagPath } from '../lib/ideas';
import { siteJsonLd } from '../lib/jsonld';
import { workKindLabel } from '../lib/projects';
import { site } from '../site';

const writing = (await publishedWriting())
  .filter((entry) => entry.data.featured)
  .slice(0, 3);
const ideas = (await publishedIdeas()).slice(0, 3);
const work = (await publishedProjects())
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);
---

<Base title={site.title} description={site.description} jsonLd={siteJsonLd()}>
  <header class="home-hero">
    <h1>{site.name}</h1>
    <div>
      <p class="home-thesis">
        I build AI systems and write about delegated authority: what they may do once they begin to act, and who answers for the result.
      </p>
      <p class="home-background">
        My work has moved from data and AI platforms at AWS and Databricks to independent systems
        experiments. I approach the work as both an engineer and an owner: who authorizes an
        action, who carries the downside, and whether the system can be stopped.
      </p>
    </div>
  </header>

  <h2 class="section-label" id="work">Selected evidence</h2>
  <EntryList
    items={work.map((entry) => ({
      href: `/work/${entry.id}/`,
      title: entry.data.title,
      datetime: entry.data.date,
      dateLabel: formatDate(entry.data.date),
      summary: entry.data.description,
      eyebrow: `${workKindLabel(entry.data.kind)} · ${entry.data.role}`,
    }))}
  />
  <p class="more"><a href="/work/">See all work</a></p>

  <section class="home-inquiry" aria-labelledby="inquiry-title">
    <h2 id="inquiry-title">Current direction</h2>
    <p>
      As AI systems move from answering questions to exercising delegated authority, how should that
      authority be granted, bounded, verified, and revoked?
    </p>
    <div class="home-inquiry-note">
      <p>
        I am testing personal AI systems built around durable private context, explicit authority,
        and work that can move between a person's own machines and shared compute. I publish the
        parts that hold up.
      </p>
    </div>
  </section>

  <h2 class="section-label" id="writing">Developed arguments</h2>
  <EntryList
    items={writing.map((entry) => ({
      href: `/writing/${entry.id}/`,
      title: entry.data.title,
      datetime: entry.data.date,
      dateLabel: formatDate(entry.data.date),
      summary: entry.data.description,
      tags: entry.data.tags.map((label) => ({ label, href: tagPath(label) })),
    }))}
  />
  <p class="more"><a href="/writing/">Read all writing</a></p>

  <h2 class="section-label" id="ideas">From the notebook</h2>
  <EntryList
    items={ideas.map((entry) => ({
      href: `/ideas/${entry.id}/`,
      title: entry.data.title,
      datetime: entry.data.developed,
      dateLabel: formatMonth(entry.data.developed),
      summary: entry.data.description,
      tags: entry.data.tags.map((label) => ({ label, href: ideaTagPath(label) })),
    }))}
  />
  <p class="more"><a href="/ideas/">Browse all ideas</a></p>

  <section class="home-contact" aria-labelledby="contact-title">
    <h2 class="section-label" id="contact-title">Get in touch</h2>
    <div class="prose">
      <p>
        I want to hear from people working out how AI systems should be governed once they act: the
        builders setting their limits and the teams accountable for what they do. Email me at <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>
  </section>
</Base>
