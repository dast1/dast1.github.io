---
import { site } from '../site';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/writing/', label: 'Writing' },
  { href: '/ideas/', label: 'Ideas' },
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
];

// Translated pages live under /ru/ and belong to the same section.
const sectionPath = path.replace(/^\/ru\//, '/');

function isCurrent(href: string): boolean {
  if (href === '/') return sectionPath === '/';
  return sectionPath === href || sectionPath.startsWith(href);
}
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/">{site.name}</a>
    <div class="header-tools">
      <nav class="nav" aria-label="Primary">
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-pressed="false"
        aria-label="Dark mode">Dark</button
      >
      <script is:inline>
        (function () {
          var root = document.documentElement;
          var button = document.querySelector('[data-theme-toggle]');
          if (!button) return;

          function paint(theme) {
            var dark = theme === 'dark';
            button.textContent = dark ? 'Light' : 'Dark';
            button.setAttribute('aria-pressed', dark ? 'true' : 'false');
            button.setAttribute('aria-label', 'Dark mode');
          }

          paint(root.dataset.theme === 'dark' ? 'dark' : 'light');

          button.addEventListener('click', function () {
            var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
            root.dataset.theme = next;
            try {
              localStorage.setItem('theme', next);
            } catch (error) {
              /* Preference stays for this view if storage is blocked. */
            }
            paint(next);
          });
        })();
      </script>
    </div>
    <details class="lang-menu" data-lang-nav>
      <summary aria-label="Choose language">
        <svg class="lang-menu-globe" aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
          <circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.2" />
          <path
            d="M1.6 8h12.8M8 1.6c2.2 2.1 2.2 10.7 0 12.8M8 1.6c-2.2 2.1-2.2 10.7 0 12.8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.2"
          />
        </svg>
        <span data-lang-current>English</span>
        <svg class="lang-menu-chevron" aria-hidden="true" viewBox="0 0 16 16" width="12" height="12">
          <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </summary>
      <ul class="lang-menu-list"></ul>
    </details>
    <script is:inline>
      (function () {
        // Runs after the menu exists: remember a chosen language, close on outside click or Escape.
        var langMenu = document.querySelector('[data-lang-nav]');
        if (!langMenu) return;
        langMenu.addEventListener('click', function (event) {
          var link = event.target.closest('a[data-lang]');
          if (!link) return;
          try {
            localStorage.setItem('lang', link.getAttribute('data-lang'));
          } catch (error) {
            /* The link still navigates; only the memory is lost. */
          }
        });
        document.addEventListener('click', function (event) {
          if (langMenu.open && !langMenu.contains(event.target)) langMenu.removeAttribute('open');
        });
        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && langMenu.open) langMenu.removeAttribute('open');
        });
      })();
    </script>
  </div>
</header>
