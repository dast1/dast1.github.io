---
import Base from '../layouts/Base.astro';
import { formatDate } from '../lib/dates';

interface TagLink {
  href: string;
  label: string;
}

interface Props {
  kicker: string;
  kickerHref: string;
  title: string;
  description: string;
  date: string;
  dateLabel?: string;
  minutes?: number;
  tags?: TagLink[];
  jsonLd?: unknown;
  hero?: { src: string; alt: string; caption?: string };
}

const { kicker, kickerHref, title, description, date, dateLabel, minutes, tags = [], jsonLd, hero } = Astro.props;
---

<Base
  title={title}
  description={description}
  ogType="article"
  published={date}
  jsonLd={jsonLd}
  imagePath={hero?.src}
  imageAlt={hero?.alt}
>
  <article class="longform">
    <header class="longform-header">
      <p class="kicker"><a href={kickerHref}>{kicker}</a></p>
      <h1>{title}</h1>
      <p class="byline">
        <time datetime={date}>{dateLabel ?? formatDate(date)}</time>
        {
          minutes && (
            <>
              <span aria-hidden="true">·</span>
              <span>{minutes} min read</span>
            </>
          )
        }
      </p>
      <slot name="meta" />
    </header>
    {
      hero && (
        <figure class="longform-hero">
          <img src={hero.src} alt={hero.alt} width="1152" height="648" fetchpriority="high" />
          {hero.caption && <figcaption>{hero.caption}</figcaption>}
        </figure>
      )
    }
    <div class="prose">
      <slot />
    </div>
    {
      tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li>
              <a href={tag.href}>{tag.label}</a>
            </li>
          ))}
        </ul>
      )
    }
    <slot name="end" />
  </article>
</Base>
