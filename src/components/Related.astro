---
import type { RelatedLink } from '../lib/related';

interface Props {
  heading: string;
  items: RelatedLink[];
}

const { heading, items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <h2 id="related-title">{heading}</h2>
      <ul>
        {items.map((item) => (
          <li>
            <span class="related-kind">{item.kind}</span>
            <a href={item.href}>{item.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )
}
